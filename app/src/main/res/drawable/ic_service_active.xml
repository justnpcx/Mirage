<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar / notification icon for the proxy service.

  This is the Mirage mark (two concentric arches on a baseline with the sun dot) reduced to a
  24dp monochrome silhouette. It replaced the old NekoBox artwork (a pink cat, #fb7299), which was
  the last piece of the old brand still visible after the launcher icon was redrawn.

  Geometry matches tools/gen_icon.py (design space 432: CX 216, stroke 28, arches 150/92, vertical
  radius x1.15, baseline y 302.25, dot r24 at x240), scaled so the mark is 20 units wide and centred
  in a 24 unit viewport. Stroke and dot are rounded up slightly (1.8 / 1.6) because a status bar
  draws this at ~24px, where the exact 1.71 / 1.46 reads as a hairline.

  Android masks status-bar icons to their alpha channel, so a plain white silhouette is correct.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- outer arch (upper half, left to right) -->
    <path
        android:pathData="M2.85,17.26 A9.15,10.52 0 0 1 21.15,17.26"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- inner arch -->
    <path
        android:pathData="M6.39,17.26 A5.61,6.45 0 0 1 17.61,17.26"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- baseline bar -->
    <path
        android:pathData="M2,17.26 L22,17.26"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- sun dot -->
    <path
        android:pathData="M13.46,14.82 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
