    <!-- ============ Mirage preference styling ============
         Applied through preferenceTheme so every preference screen (settings, route, and all
         protocol editors) picks it up without touching their XML.

         Note it is not enough to override preferenceStyle: MaterialComponents themes resolve
         BasePreferenceThemeOverlay, which maps each preference family to its own
         Preference.*.Material style, and every one of those pins android:layout. The app uses
         plain Preference, SwitchPreference, EditTextPreference and DropDownPreference, so each
         family is re-pointed here. SeekBarPreference / DropDownPreference-as-widget are left
         alone: their layouts carry a real widget and are unused by this app. -->
    <style name="PreferenceThemeOverlay.Mirage" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.Mirage</item>
        <item name="preferenceCategoryStyle">@style/PreferenceCategory.Mirage</item>
