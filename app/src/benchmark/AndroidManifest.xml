<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the `benchmark` build type gets this. androidx.benchmark's BaselineProfileRule needs the app
  under test to be profileable from the shell; without it the run fails with "the app is not
  profileable". Release builds must NOT carry it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
